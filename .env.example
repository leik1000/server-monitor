MONITOR_REFRESH_SECONDS=15
MONITOR_REQUEST_TIMEOUT=12
MONITOR_VERIFY_SSL=true
MONITOR_TARGETS_FILE=/app/config/targets.json
MONITOR_COOKIE_POOL_FILE=/app/config/cookies.json
MONITOR_ACCOUNT_POOL_DB=/app/config/account_pool.sqlite3
MONITOR_IMPORT_PARALLELISM=3
MONITOR_REFILL_INTERVAL_SECONDS=300
MONITOR_SYSTEM_USERNAME=admin
MONITOR_SYSTEM_PASSWORD=admin
MONITOR_SESSION_DAYS=30
